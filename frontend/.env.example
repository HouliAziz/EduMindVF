# EduMind Frontend — environment template
# Copy to .env.local and adjust as needed. Vite only exposes vars prefixed with VITE_.

# Base URL for the Symfony API. Leave commented to use the Vite dev proxy ("/api/v1").
# In production, point this to the backend, e.g.:
# VITE_API_URL=https://api.edumind.example.com/api/v1
# VITE_API_URL=/api/v1
